--- a/pyogrio/_geometry.pyx	2026-08-25 23:03:41
+++ b/pyogrio/_geometry.pyx	2026-08-25 23:03:41
@@ -1,6 +1,14 @@
 import warnings
 from pyogrio._ogr cimport *
 from pyogrio._err cimport *
+
+# With a static libgdal (iOS) each extension links its own copy of GDAL and
+# gets its own driver registry. pyogrio registers in _ogr, but this module
+# resolves driver names itself, in a registry nobody populates — so an open
+# fails here while _ogr-backed calls succeed. Registering here fixes that.
+# GDALAllRegister is idempotent, so Android, which shares one libgdal.so and
+# therefore one registry, is unaffected.
+GDALAllRegister()
 from pyogrio._err import CPLE_BaseError, NullPointerError
 from pyogrio.errors import DataLayerError, GeometryError
 
