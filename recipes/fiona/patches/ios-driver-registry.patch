diff -ru orig/fiona/_geometry.pyx fiona-1.10.1/fiona/_geometry.pyx
--- a/fiona/_geometry.pyx	2026-08-25 23:10:07
+++ b/fiona/_geometry.pyx	2026-08-25 23:10:07
@@ -2,6 +2,16 @@
 
 include "gdal.pxi"
 
+# With a static libgdal (iOS) each extension links its own copy of GDAL and
+# gets its own driver registry. fiona registers in _env, but this module opens
+# datasets itself and resolves driver names in a registry nothing populates —
+# which is what surfaces as FionaNullPointerError on a write. Registering here
+# makes this module's registry usable. GDALAllRegister and OGRRegisterAll are
+# idempotent, so Android, which shares one libgdal.so and therefore one
+# registry, is unaffected.
+GDALAllRegister()
+OGRRegisterAll()
+
 import logging
 
