--- a/rasterio/_base.pyx	2026-08-25 22:54:38
+++ b/rasterio/_base.pyx	2026-08-25 22:54:10
@@ -53,6 +53,14 @@
 
 include "gdal.pxi"
 
+# Each extension links its own copy of GDAL when libgdal is a static archive
+# (iOS), so the driver registry `_env` populates is not the one this module
+# looks names up in — GDALGetDriverByName below then fails with "No such
+# driver registered". Registering here makes this module's own registry
+# usable. GDALAllRegister is idempotent, so this is a no-op on Android, where
+# a single shared libgdal.so means there was only ever one registry.
+GDALAllRegister()
+
