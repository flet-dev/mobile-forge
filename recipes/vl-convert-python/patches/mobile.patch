-vl-convert-canvas2d-deno = { workspace = true }
diff -ruN a/vl-convert-rs/forge_build.rs b/vl-convert-rs/forge_build.rs
--- a/vl-convert-rs/forge_build.rs
+++ b/vl-convert-rs/forge_build.rs
@@ -0,0 +1,10 @@
+fn main() {
+    let out_dir = std::path::PathBuf::from(std::env::var_os("OUT_DIR").unwrap());
+    std::fs::write(out_dir.join("VL_CONVERT_SNAPSHOT.bin"), []).unwrap();
+    std::fs::write(
+        out_dir.join("VL_CONVERT_RESIDUAL_SOURCES.rs"),
+        "pub(crate) static VL_CONVERT_RESIDUAL_LAZY_JS: &[(&str, &str)] = &[];\n\
+         pub(crate) static VL_CONVERT_RESIDUAL_LAZY_ESM: &[(&str, &str)] = &[];\n",
+    )
+    .unwrap();
+}
diff -ruN a/vl-convert-rs/src/converter/inner/mod.rs b/vl-convert-rs/src/converter/inner/mod.rs
--- a/vl-convert-rs/src/converter/inner/mod.rs
+++ b/vl-convert-rs/src/converter/inner/mod.rs
@@ -189,7 +189,7 @@
                 // Runtime extension for worker-local JSON/msgpack transfer ops.
                 super::vl_convert_runtime::init(),
             ],
-            startup_snapshot: Some(crate::VL_CONVERT_SNAPSHOT),
+            startup_snapshot: None,
             residual_lazy_js_sources: crate::VL_CONVERT_RESIDUAL_LAZY_JS,
             residual_lazy_esm_sources: crate::VL_CONVERT_RESIDUAL_LAZY_ESM,
             create_params,
