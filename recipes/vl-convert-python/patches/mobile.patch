diff -ruN a/vl-convert-python/forge_tls.c b/vl-convert-python/forge_tls.c
--- a/vl-convert-python/forge_tls.c
+++ b/vl-convert-python/forge_tls.c
@@ -0,0 +1,110 @@
+// Virtual pthread TLS keys for everything linked into this extension.
+//
+// Rust has no native TLS on Android, so std backs every thread_local! with a
+// pthread key of its own, and bionic allows a process about 128. A vl-convert
+// worker touches around 80, which leaves too few for the next native module to
+// load ("fatal runtime error: out of TLS keys"). These definitions are hidden,
+// so they bind every reference inside this .so and nothing outside it: all of
+// the extension's keys share one real key that holds a per-thread table.
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define HIDDEN __attribute__((visibility("hidden")))
+#define MAX_KEYS 4096
+#define DESTRUCTOR_PASSES 4
+
+typedef void (*dtor_fn)(void *);
+typedef struct {
+  size_t cap;
+  void *slots[];
+} table;
+
+static pthread_once_t once = PTHREAD_ONCE_INIT;
+static pthread_key_t real_key;
+static void *(*real_get)(pthread_key_t);
+static int (*real_set)(pthread_key_t, const void *);
+static atomic_uint next_key = 1;  // 0 is never handed out
+static _Atomic(dtor_fn) dtors[MAX_KEYS];
+
+// Runs at thread exit with the thread's table, which bionic has already
+// detached. Reattach it so destructors that touch other thread-locals see
+// their values, and re-read it after each call because a destructor may grow it.
+static void run_destructors(void *value) {
+  real_set(real_key, value);
+  for (int pass = 0; pass < DESTRUCTOR_PASSES; pass++) {
+    int ran = 0;
+    for (size_t key = 1;; key++) {
+      table *t = real_get(real_key);
+      if (key >= t->cap) break;
+      // As bionic does: a value with no destructor stays readable by later
+      // destructors (Rust std's thread handle cleanup reads one) and is
+      // simply dropped with the table.
+      void *slot = t->slots[key];
+      dtor_fn dtor = atomic_load(&dtors[key]);
+      if (!slot || !dtor) continue;
+      t->slots[key] = NULL;
+      dtor(slot);
+      ran = 1;
+    }
+    if (!ran) break;
+  }
+  table *t = real_get(real_key);
+  real_set(real_key, NULL);
+  free(t);
+}
+
+static void init(void) {
+  int (*real_create)(pthread_key_t *, dtor_fn) = dlsym(RTLD_DEFAULT, "pthread_key_create");
+  real_get = dlsym(RTLD_DEFAULT, "pthread_getspecific");
+  real_set = dlsym(RTLD_DEFAULT, "pthread_setspecific");
+  if (!real_create || !real_get || !real_set || real_create(&real_key, run_destructors)) abort();
+}
+
+HIDDEN int pthread_key_create(pthread_key_t *key, dtor_fn dtor) {
+  pthread_once(&once, init);
+  unsigned k = atomic_fetch_add(&next_key, 1);
+  if (k >= MAX_KEYS) return EAGAIN;
+  atomic_store(&dtors[k], dtor);
+  *key = (pthread_key_t)k;
+  return 0;
+}
+
+// IDs are not reused, so MAX_KEYS bounds creates over the process's life.
+// Reuse would need per-slot generations to hide a deleted key's values, and
+// nothing here churns keys: Rust std deletes one only on a lost init race.
+HIDDEN int pthread_key_delete(pthread_key_t key) {
+  if (key <= 0 || (unsigned)key >= MAX_KEYS) return EINVAL;
+  atomic_store(&dtors[key], NULL);
+  return 0;
+}
+
+HIDDEN void *pthread_getspecific(pthread_key_t key) {
+  pthread_once(&once, init);
+  table *t = real_get(real_key);
+  return (t && key > 0 && (size_t)key < t->cap) ? t->slots[key] : NULL;
+}
+
+HIDDEN int pthread_setspecific(pthread_key_t key, const void *value) {
+  pthread_once(&once, init);
+  if (key <= 0 || (unsigned)key >= atomic_load(&next_key)) return EINVAL;
+  table *t = real_get(real_key);
+  if (!t || (size_t)key >= t->cap) {
+    if (!value) return 0;
+    size_t old = t ? t->cap : 0;
+    size_t cap = old ? old : 64;
+    while (cap <= (size_t)key) cap *= 2;
+    table *grown = realloc(t, sizeof(table) + cap * sizeof(void *));
+    if (!grown) return ENOMEM;
+    memset(&grown->slots[old], 0, (cap - old) * sizeof(void *));
+    grown->cap = cap;
+    real_set(real_key, grown);
+    t = grown;
+  }
+  t->slots[key] = (void *)value;
+  return 0;
+}
