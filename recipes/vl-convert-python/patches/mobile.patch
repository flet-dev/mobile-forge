diff -ruN a/vl-convert-google-fonts/src/mobile_tls.rs b/vl-convert-google-fonts/src/mobile_tls.rs
--- a/vl-convert-google-fonts/src/mobile_tls.rs
+++ b/vl-convert-google-fonts/src/mobile_tls.rs
@@ -0,0 +1,34 @@
+/// Applied to every reqwest client vl-convert builds.
+///
+/// reqwest's rustls backend checks certificates through rustls-platform-verifier,
+/// which on Android panics unless it was first initialised from Java with a JNI
+/// context. A Python extension never is, so trust the bundled Mozilla roots there.
+pub trait MobileTls: Sized {
+    fn mobile_tls(self) -> Self;
+}
+
+#[cfg(target_os = "android")]
+fn root_certs() -> Vec<reqwest::Certificate> {
+    webpki_root_certs::TLS_SERVER_ROOT_CERTS
+        .iter()
+        .filter_map(|der| reqwest::Certificate::from_der(der).ok())
+        .collect()
+}
+
+impl MobileTls for reqwest::ClientBuilder {
+    fn mobile_tls(self) -> Self {
+        #[cfg(target_os = "android")]
+        return self.tls_certs_only(root_certs());
+        #[cfg(not(target_os = "android"))]
+        self
+    }
+}
+
+impl MobileTls for reqwest::blocking::ClientBuilder {
+    fn mobile_tls(self) -> Self {
+        #[cfg(target_os = "android")]
+        return self.tls_certs_only(root_certs());
+        #[cfg(not(target_os = "android"))]
+        self
+    }
+}
