Cross-compile cffi against the target's libffi, not the build machine's.

setup.py: drop the /usr/include/ffi and /usr/include/libffi defaults and the
pkg-config probe, which would point a cross build at the host's libffi
headers; forge's cross environment supplies the target paths.

malloc_closure.h: guard the Linux-only PaX getline() scan by
__ANDROID_API__ >= 18, as Chaquopy does (bionic gained getline() at API 18).
A no-op at forge's API 24.

Regenerated against 2.1.1, where the setup.py hunk moved by 6 lines.

diff -ruN a/setup.py b/setup.py
--- a/setup.py
+++ b/setup.py
@@ -9,8 +9,7 @@
 
 sources = ['src/c/_cffi_backend.c']
 libraries = ['ffi']
-include_dirs = ['/usr/include/ffi',
-                '/usr/include/libffi']    # may be changed by pkg-config
+include_dirs = [] # Don't use system include dirs when cross compiling
 define_macros = [('FFI_BUILDING', '1')]   # for linking with libffi static library
 library_dirs = []
 extra_compile_args = []
@@ -150,7 +149,7 @@
         sources.extend(os.path.join(COMPILE_LIBFFI, filename)
                     for filename in _filenames)
 else:
-    use_pkg_config()
+    #use_pkg_config()
     ask_supports_thread()
     ask_supports_sync_synchronize()
 
diff -ruN a/src/c/malloc_closure.h b/src/c/malloc_closure.h
--- a/src/c/malloc_closure.h
+++ b/src/c/malloc_closure.h
@@ -42,6 +42,8 @@
         return 0;
     ret = 0;
 
+    /* Chaquopy: getline requires API level 18, but PaX isn't used by Android anyway. */
+    #if __ANDROID_API__ >= 18
     while (getline (&buf, &len, f) != -1)
         if (!strncmp (buf, "PaX:", 4))
             {
@@ -51,6 +53,8 @@
                 break;
             }
     free (buf);
+    #endif
+    
     fclose (f);
     return ret;
 }
