Build a per-version extension instead of abi3.

With the abi3-py39 feature, PyO3 links iOS extensions against
`-lpython3.9`, which no iOS Python tree has. Drop abi3 so each wheel links
its own libpython, matching the other PyO3 recipes.

diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -9,7 +9,7 @@
 crate-type = ["cdylib"]
 
 [dependencies]
-pyo3 = { version = "0.29", features = ["extension-module", "abi3-py39"] }
+pyo3 = { version = "0.29", features = ["extension-module"] }
 pyo3-async-runtimes = { version = "0.29", features = ["tokio-runtime"] }
 surrealdb-core = { version = "4", default-features = false, features = [
     "kv-mem",
