iOS compatibility: retain the Mach APIs used by sysinfo 0.39.6 via libc
0.2.189; 0.2.190 restricts those declarations to macOS. Build PyO3 against
the selected mobile Python instead of abi3-py39: maturin 1.16 otherwise
requests nonexistent libpython3.9. Forge supplies Python framework linkage
and emits cp312-cp312 wheels. Preserve all database features and Android.

diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml	2026-11-15 16:56:51
+++ b/Cargo.toml	2026-11-15 16:56:51
@@ -9,7 +9,7 @@
 crate-type = ["cdylib"]
 
 [dependencies]
-pyo3 = { version = "0.29", features = ["extension-module", "abi3-py39"] }
+pyo3 = { version = "0.29", features = ["extension-module"] }
 pyo3-async-runtimes = { version = "0.29", features = ["tokio-runtime"] }
 surrealdb-core = { version = "4", default-features = false, features = [
     "kv-mem",
@@ -37,6 +37,10 @@
 surrealdb-types = "4"
 tokio = { version = "1", features = ["full"] }
 uuid = "1.27"
+
+[target.'cfg(target_os = "ios")'.dependencies]
+# libc 0.2.190 hides Mach APIs still used by sysinfo 0.39.6 on iOS.
+libc = "=0.2.189"
 
 [profile.release]
 lto = true
