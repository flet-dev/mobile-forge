Pin libc to 0.2.189 on iOS.

sysinfo 0.39.6 uses Mach APIs that libc 0.2.190 restricts to macOS, so the
iOS build fails against the locked 0.2.190.

diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -37,6 +37,10 @@
 surrealdb-types = "4"
 tokio = { version = "1", features = ["full"] }
 uuid = "1.27"
+
+[target.'cfg(target_os = "ios")'.dependencies]
+# libc 0.2.190 hides Mach APIs still used by sysinfo 0.39.6 on iOS.
+libc = "=0.2.189"
 
 [profile.release]
 lto = true
