xgboost finds libxgboost and its own VERSION file through paths built from
__file__, and names the library after the platform it was built on. Four
mobile adjustments, all inert on desktop builds:

1. CMakeLists.txt: name the library libxgboost.so on iOS, not .dylib, so
   it has one name on both mobile platforms. serious_python moves it into
   an embedded framework and leaves libxgboost.fwork in its place.
2. cpp_src/CMakeLists.txt: no VERSION/SOVERSION on Android and iOS, so the
   soname matches the unversioned file the wheel ships.
3. xgboost/libpath.py: teach it the "android" sys.platform (3.13+; Android
   3.12 reports "linux") and "ios" with its .fwork pointer, and give
   Android a fallback to the bare soname -- Flet relocates the .so into the
   APK's native library dir, where no __file__-relative path can reach it.
4. xgboost/_c_api.py: read VERSION through importlib.resources. On Android
   Flet ships site-packages as a zip, so the __file__-relative open() runs
   into NotADirectoryError on every `import xgboost`.

diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-10-03 20:43:24
+++ b/CMakeLists.txt	2026-10-04 03:18:37
@@ -39,6 +39,9 @@
 # Platform-specific library file name (matches xgboost/libpath.py).
 if(WIN32)
   set(_XGB_LIBNAME "xgboost.dll")
+elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+  # mobile-forge: one library name on both mobile platforms.
+  set(_XGB_LIBNAME "libxgboost.so")
 elseif(APPLE)
   set(_XGB_LIBNAME "libxgboost.dylib")
 else()
diff -ruN a/cpp_src/CMakeLists.txt b/cpp_src/CMakeLists.txt
--- a/cpp_src/CMakeLists.txt	2026-10-03 20:43:24
+++ b/cpp_src/CMakeLists.txt	2026-10-03 20:43:50
@@ -405,9 +405,11 @@
 else()
   # Provide versioned shared object
   add_library(xgboost SHARED)
-  set_target_properties(xgboost PROPERTIES
-    VERSION ${PROJECT_VERSION}
-    SOVERSION ${PROJECT_VERSION_MAJOR})
+  if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Android|iOS)$")
+    set_target_properties(xgboost PROPERTIES
+      VERSION ${PROJECT_VERSION}
+      SOVERSION ${PROJECT_VERSION_MAJOR})
+  endif()
 endif()
 target_link_libraries(xgboost PRIVATE objxgboost)
 target_include_directories(xgboost
diff -ruN a/xgboost/_c_api.py b/xgboost/_c_api.py
--- a/xgboost/_c_api.py	2026-10-03 21:12:29
+++ b/xgboost/_c_api.py	2026-10-03 21:12:29
@@ -82,9 +82,12 @@
 
 def _py_version() -> str:
     """Get the XGBoost version from Python version file."""
-    version_file = os.path.join(os.path.dirname(__file__), "VERSION")
-    with open(version_file, encoding="ascii") as f:
-        return f.read().strip()
+    # mobile-forge: importlib.resources also reads it from a zipped
+    # site-packages (Flet on Android), where a __file__ path cannot.
+    from importlib.resources import files
+
+    version_file = files(__package__).joinpath("VERSION")
+    return version_file.read_text(encoding="ascii").strip()
 
 
 def _register_log_callback(lib: ctypes.CDLL) -> None:
diff -ruN a/xgboost/libpath.py b/xgboost/libpath.py
--- a/xgboost/libpath.py	2026-10-03 20:43:24
+++ b/xgboost/libpath.py	2026-10-04 03:18:37
@@ -49,16 +49,25 @@
             ]
         )
         dll_path = [os.path.join(p, "xgboost.dll") for p in dll_path]
-    elif sys.platform.startswith(("linux", "freebsd", "emscripten")):
+    elif sys.platform.startswith(("linux", "freebsd", "emscripten", "android")):
         dll_path = [os.path.join(p, "libxgboost.so") for p in dll_path]
     elif sys.platform == "darwin":
         dll_path = [os.path.join(p, "libxgboost.dylib") for p in dll_path]
+    elif sys.platform == "ios":
+        # mobile-forge: the app packager moves the library into an embedded
+        # framework and leaves a .fwork pointer, which iOS ctypes follows.
+        names = ("libxgboost.fwork", "libxgboost.so")
+        dll_path = [os.path.join(p, n) for p in dll_path for n in names]
     elif sys.platform == "cygwin":
         dll_path = [os.path.join(p, "cygxgboost.dll") for p in dll_path]
     if platform.system() == "OS400":
         dll_path = [os.path.join(p, "libxgboost.so") for p in dll_path]
 
     lib_path = [p for p in dll_path if os.path.exists(p) and os.path.isfile(p)]
+    if not lib_path and hasattr(sys, "getandroidapilevel"):
+        # mobile-forge: Flet moves the .so out of site-packages into the APK's
+        # native library directory, where the linker resolves it by bare name.
+        lib_path = ["libxgboost.so"]
 
     if not lib_path and not is_sphinx_build():
         link = "https://xgboost.readthedocs.io/en/stable/install.html"
